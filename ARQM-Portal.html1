// *** لتغيير رابط الكاميرات: عدّل السطر التالي فقط ***
var CAMERA_URL = 'https://cameras.arqm.sa'; // ← ضع رابط نظام الكاميرات هنا

function openCamera() {
  if (!DEMO_BOOKINGS || DEMO_BOOKINGS.length === 0) {
    showToast('يجب أن يكون لديك حجز نشط للوصول للكاميرات', 'red');
    return;
  }
  // Show loading toast then open
  showToast('جارٍ فتح نظام المراقبة...', 'green');
  setTimeout(function() {
    window.open(CAMERA_URL, '_blank');
  }, 600);
}

// ── MAIN VIEW SWITCHER ──
var mainView = 'compounds';

function switchMainView(v) {
  mainView = v;
  document.getElementById('mnav-compounds').classList.toggle('active', v==='compounds' || v==='detail');
  document.getElementById('mnav-bookings').classList.toggle('active', v==='bookings');
  document.getElementById('mnav-camera').classList.remove('active');
  var all = ['view-overview','view-detail','view-bookings','view-camera'];
  all.forEach(function(id) { document.getElementById(id).style.display = 'none'; });
  if (v === 'compounds') {
    showOverview();
  } else if (v === 'bookings') {
    document.getElementById('view-bookings').style.display = 'block';
    renderBookings();
    document.getElementById('wl-text').querySelector('h2').textContent = 'حجوزاتي 📋';
    document.getElementById('wl-text').querySelector('p').textContent = 'تفاصيل عقودك وحجوزاتك النشطة';
  }
}

