var DEMO_BOOKINGS = [
  {
    id: 'BK-2025-001',
    cmpId: 'rimal',
    room: 'غرفة 301',
    roomId: 'R-301',
    beds: 4,
    startDate: '2025-01-15',
    endDate: '2025-07-15',
    totalMonths: 6,
    services: ['سكن', 'إعاشة', 'نقل'],
    totalAmount: 14400,
    monthlyAmount: 2400,
    status: 'active'
  },
  {
    id: 'BK-2024-089',
    cmpId: 'nahda',
    room: 'غرفة 203',
    roomId: 'N-203',
    beds: 6,
    startDate: '2024-08-01',
    endDate: '2025-08-01',
    totalMonths: 12,
    services: ['سكن', 'إعاشة'],
    totalAmount: 38880,
    monthlyAmount: 3240,
    status: 'active'
  }
];

function daysBetween(d1, d2) {
  var t1 = new Date(d1).getTime();
  var t2 = new Date(d2).getTime();
  return Math.round((t2 - t1) / (1000*60*60*24));
}

function formatDate(d) {
  var parts = d.split('-');
  return parts[2] + '/' + parts[1] + '/' + parts[0];
}

function renderBookings() {
  var container = document.getElementById('bookings-content');
  var html = '';
  var today = new Date().toISOString().split('T')[0];

  if (DEMO_BOOKINGS.length === 0) {
    html = '<div style="text-align:center;padding:60px;color:rgba(232,220,200,.25)"><div style="font-size:3rem;margin-bottom:12px">📋</div><div style="font-size:15px;font-weight:700">لا توجد حجوزات نشطة</div></div>';
    container.innerHTML = html;
    return;
  }

  DEMO_BOOKINGS.forEach(function(b, idx) {
    var c = CMP.filter(function(x) { return x.id === b.cmpId; })[0];
    var daysLeft = daysBetween(today, b.endDate);
    var daysTotal = daysBetween(b.startDate, b.endDate);
    var daysUsed = daysTotal - daysLeft;
    var progressPct = Math.max(0, Math.min(100, Math.round((daysUsed / daysTotal) * 100)));
    var isEnding = daysLeft < 45;
    var barColor = isEnding ? 'var(--red)' : 'var(--lime)';
    var statusClass = isEnding ? 'bst-ending' : 'bst-active';
    var statusTxt = isEnding ? ('ينتهي خلال ' + daysLeft + ' يوم') : 'نشط';
    var svcTxt = b.services.join(' · ');

    html +=
      '<div class="booking-card" style="animation-delay:' + (idx*0.1) + 's">' +
        '<div class="booking-header">' +
          '<div>' +
            '<div style="font-size:16px;font-weight:900;color:var(--cream)">' + c.icon + ' ' + c.name + '</div>' +
            '<div class="booking-id">' + b.room + ' · ' + b.id + '</div>' +
          '</div>' +
          '<span class="booking-status ' + statusClass + '">' + statusTxt + '</span>' +
        '</div>' +
        '<div class="booking-body">' +
          '<div class="booking-stat"><div class="bst-num">' + b.beds + '</div><div class="bst-label">سرير محجوز</div></div>' +
          '<div class="booking-stat"><div class="bst-num">' + b.totalMonths + '</div><div class="bst-label">شهر إجمالي</div></div>' +
          '<div class="booking-stat"><div class="bst-num" style="color:' + (isEnding?'var(--red)':'var(--lime)') + '">' + daysLeft + '</div><div class="bst-label">يوم متبقي</div></div>' +
          '<div class="booking-stat"><div class="bst-num">' + b.monthlyAmount.toLocaleString() + '</div><div class="bst-label">ر.س / شهر</div></div>' +
        '</div>' +
        '<div style="padding:16px 20px;border-top:1px solid var(--line2)">' +
          '<div style="margin-bottom:10px">' +
            '<div style="display:flex;justify-content:space-between;font-size:12px;font-weight:700;color:rgba(232,220,200,.45);margin-bottom:6px">' +
              '<span>مدة العقد</span>' +
              '<span>' + progressPct + '% منجز</span>' +
            '</div>' +
            '<div class="ct-bar">' +
              '<div class="ct-fill" id="ctbar-' + idx + '" style="width:0%;background:' + barColor + '"></div>' +
            '</div>' +
          '</div>' +
          '<div class="booking-info-row">' +
            '<div class="booking-info-item">📅 بداية العقد: <strong>' + formatDate(b.startDate) + '</strong></div>' +
            '<div class="booking-info-item">🏁 نهاية العقد: <strong>' + formatDate(b.endDate) + '</strong></div>' +
            '<div class="booking-info-item">🛠️ الخدمات: <strong>' + svcTxt + '</strong></div>' +
            '<div class="booking-info-item">💰 الإجمالي: <strong>' + b.totalAmount.toLocaleString() + ' ر.س</strong></div>' +
          '</div>' +
        '</div>' +
        '<div class="booking-footer">' +
          (isEnding ?
            '<div style="font-size:13px;color:var(--red);font-weight:800">⚠️ عقدك ينتهي قريباً — تواصل معنا لتجديده</div>' :
            '<div style="font-size:13px;color:rgba(232,220,200,.4);font-weight:700">✅ العقد ساري ولا يحتاج تجديداً الآن</div>'
          ) +
          '<div style="display:flex;gap:8px">' +
            '<button class="btn-wa" style="padding:8px 16px;font-size:12px" onclick="window.open(\'https://wa.me/966555589155?text=' + encodeURIComponent('مرحباً، أريد الاستفسار عن تجديد عقدي رقم ' + b.id) + '\',\'_blank\')">تجديد العقد</button>' +
            '<button class="btn-outline-gold" style="padding:8px 16px;font-size:12px" onclick="openCamera()">📹 المراقبة</button>' +
          '</div>' +
        '</div>' +
      '</div>';
  });

  container.innerHTML = html;
  // Animate bars
  setTimeout(function() {
    DEMO_BOOKINGS.forEach(function(b, idx) {
      var today = new Date().toISOString().split('T')[0];
      var daysLeft = daysBetween(today, b.endDate);
      var daysTotal = daysBetween(b.startDate, b.endDate);
      var daysUsed = daysTotal - daysLeft;
      var pct = Math.max(0, Math.min(100, Math.round((daysUsed/daysTotal)*100)));
      var bar = document.getElementById('ctbar-' + idx);
      if (bar) bar.style.width = pct + '%';
    });
  }, 200);
}

// ── CAMERA ──
var CAMERAS = [
  {id:'cam1', name:'مدخل رئيسي', loc:'Sulai Camp', icon:'🏗️', cmpId:'sulai'},
  {id:'cam2', name:'ممر الطابق الأول', loc:'Sulai Camp', icon:'🏗️', cmpId:'sulai'},
  {id:'cam3', name:'صالة الطعام', loc:'Al Rimal', icon:'🌆', cmpId:'rimal'},
  {id:'cam4', name:'مدخل المبنى B', loc:'Al Rimal', icon:'🌆', cmpId:'rimal'}
];

var expandedCam = null;
var camClock = null;

function renderCamera() {
  // Check if user has bookings
  if (DEMO_BOOKINGS.length === 0) {
    document.getElementById('camera-content').innerHTML =
      '<div class="cam-grid"><div class="cam-no-booking">' +
        '<div class="cam-no-booking-icon">🔒</div>' +
        '<div class="cam-no-booking-txt">لا يوجد حجوزات نشطة</div>' +
        '<div class="cam-no-booking-sub">يجب أن يكون لديك حجز نشط للوصول للكاميرات</div>' +
      '</div></div>';
    return;
  }

  var html = '<div class="cam-grid" id="cam-grid">';
  CAMERAS.forEach(function(cam, idx) {
    var isExpanded = expandedCam === cam.id;
    html +=
      '<div class="cam-feed' + (isExpanded?' fullscreen-cam':'') + '" id="' + cam.id + '" style="animation-delay:' + (idx*0.12) + 's">' +
        '<div class="cam-screen" onclick="expandCam(\'' + cam.id + '\')">' +
          '<div class="cam-noise"></div>' +
          '<div class="cam-scanline"></div>' +
          '<div class="cam-scene">' +
            '<div class="cam-building">' + cam.icon + '</div>' +
            '<div style="font-size:11px;color:rgba(74,222,128,.5);font-weight:700;margin-top:8px;font-family:monospace">LIVE STREAM</div>' +
          '</div>' +
          '<div class="cam-time" id="ct-' + cam.id + '">00:00:00</div>' +
          '<div class="cam-rec"><div class="cam-rec-dot"></div>REC</div>' +
          '<div class="cam-name">' + cam.name + '</div>' +
          '<div class="cam-expand">' + (isExpanded ? '⊠ تصغير' : '⊞ تكبير') + '</div>' +
        '</div>' +
        '<div class="cam-info">' +
          '<div>' +
            '<div class="cam-info-name">' + cam.name + '</div>' +
            '<div class="cam-info-loc">📍 ' + cam.loc + '</div>' +
          '</div>' +
          '<div class="cam-status"><div style="width:7px;height:7px;border-radius:50%;background:var(--lime);animation:lp 1s infinite"></div>متصل</div>' +
        '</div>' +
      '</div>';
  });
  html += '</div>';
  document.getElementById('camera-content').innerHTML = html;

  // Live clock
  clearInterval(camClock);
  camClock = setInterval(function() {
    var now = new Date();
    var timeStr = now.getHours().toString().padStart(2,'0') + ':' +
                  now.getMinutes().toString().padStart(2,'0') + ':' +
                  now.getSeconds().toString().padStart(2,'0');
    CAMERAS.forEach(function(cam) {
      var el = document.getElementById('ct-' + cam.id);
      if (el) el.textContent = timeStr;
    });
  }, 1000);
}

function expandCam(id) {
  expandedCam = expandedCam === id ? null : id;
  renderCamera();
}

// ── PRICING CALCULATOR ──
var calcState = {
  beds: 1,
  duration: 6,
  catering: false,
  transport: false,
  freeBeds: 0,
  cmpName: '',
  cmpId: ''
};

var PRICES = {
  bed: 500,
  catering: 60,
  transport: 100,
  discountYear: 0.10
};

function initCalc(freeBeds, cmpName, cmpId) {
  calcState.freeBeds = freeBeds;
  calcState.cmpName  = cmpName;
  calcState.cmpId    = cmpId;
  calcState.beds     = Math.min(1, freeBeds);
  calcState.duration = 6;
  calcState.catering = false;
  calcState.transport= false;
  // reset UI
  setDuration(6);
  updateBedsUI();
  document.getElementById('svc-catering').classList.remove('checked');
  document.getElementById('svc-transport').classList.remove('checked');
  document.getElementById('box-catering').innerHTML = '';
  document.getElementById('box-transport').innerHTML= '';
  updatePrice();
}

function setDuration(months) {
  calcState.duration = months;
  document.getElementById('tab-6').classList.toggle('active', months===6);
  document.getElementById('tab-12').classList.toggle('active', months===12);
  updatePrice();
}

function changeBeds(delta) {
  var next = calcState.beds + delta;
  if (next < 1) return;
  if (next > calcState.freeBeds) return;
  calcState.beds = next;
  updateBedsUI();
  updatePrice();
}

function updateBedsUI() {
  document.getElementById('beds-num').textContent = calcState.beds;
  document.getElementById('btn-minus').disabled = calcState.beds <= 1;
  document.getElementById('btn-plus').disabled  = calcState.beds >= calcState.freeBeds;
  var note = document.getElementById('avail-note');
  note.textContent = calcState.freeBeds + ' سرير متاح في هذا المجمع';
}

function toggleSvc(svc) {
  calcState[svc] = !calcState[svc];
  var el  = document.getElementById('svc-' + svc);
  var box = document.getElementById('box-' + svc);
  el.classList.toggle('checked', calcState[svc]);
  box.innerHTML = calcState[svc]
    ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>'
    : '';
  updatePrice();
}

function formatNum(n) {
  return n.toLocaleString('ar-SA');
}

function updatePrice() {
  var b  = calcState.beds;
  var mo = calcState.duration;
  var disc = mo === 12 ? PRICES.discountYear : 0;

  var bedMonthly      = b * PRICES.bed;
  var cateringMonthly = calcState.catering  ? b * PRICES.catering  : 0;
  var transportMonthly= calcState.transport ? b * PRICES.transport : 0;
  var monthlyTotal    = bedMonthly + cateringMonthly + transportMonthly;
  var beforeDisc      = monthlyTotal * mo;
  var discAmount      = Math.round(beforeDisc * disc);
  var grandTotal      = beforeDisc - discAmount;
  var perBedMonth     = Math.round(monthlyTotal);

  var rows = '';
  rows += '<div class="price-row"><span>🛏️ ' + b + ' سرير × ' + formatNum(PRICES.bed) + ' ر.س</span><span class="price-row-val">' + formatNum(bedMonthly) + ' ر.س/شهر</span></div>';
  if (calcState.catering)
    rows += '<div class="price-row"><span>🍽️ إعاشة × ' + b + ' عامل</span><span class="price-row-val">' + formatNum(cateringMonthly) + ' ر.س/شهر</span></div>';
  if (calcState.transport)
    rows += '<div class="price-row"><span>🚌 نقل × ' + b + ' عامل</span><span class="price-row-val">' + formatNum(transportMonthly) + ' ر.س/شهر</span></div>';

  rows += '<div class="price-row"><span>📅 المدة</span><span class="price-row-val">' + mo + ' أشهر</span></div>';

  if (discAmount > 0)
    rows += '<div class="price-row"><span style="color:var(--lime)">🎉 خصم السنة (10%)</span><span class="price-row-val" style="color:var(--lime)">− ' + formatNum(discAmount) + ' ر.س</span></div>';

  var discBadge = discAmount > 0
    ? '<div class="price-discount-badge">🎉 وفّرت ' + formatNum(discAmount) + ' ر.س باختيار السنة الكاملة</div>'
    : '';

  document.getElementById('price-result').innerHTML =
    '<div class="price-rows">' + rows + '</div>' +
    '<div class="price-divider"></div>' +
    '<div class="price-total-row">' +
      '<div>' +
        '<div class="price-total-label">الإجمالي الكلي</div>' +
        '<div class="price-total-period">' + formatNum(perBedMonth) + ' ر.س / شهرياً</div>' +
      '</div>' +
      '<div style="text-align:left">' +
        '<div class="price-total-val">' + formatNum(grandTotal) + '</div>' +
        '<div class="price-total-period">ريال سعودي</div>' +
      '</div>' +
    '</div>' +
    discBadge;

  // Update WA button
  var ph = document.getElementById('up').textContent;
  var svcTxt = [];
  svcTxt.push('سكن');
  if (calcState.catering)  svcTxt.push('إعاشة');
  if (calcState.transport) svcTxt.push('نقل');

  var msg = 'مرحباً، أريد حجز من بوابة أرقـم.\n\n'
    + 'المجمع: ' + calcState.cmpName + '\n'
    + 'عدد الأسرة: ' + b + ' سرير\n'
    + 'المدة: ' + mo + ' أشهر\n'
    + 'الخدمات: ' + svcTxt.join(' + ') + '\n'
    + 'الإجمالي: ' + formatNum(grandTotal) + ' ر.س\n'
    + 'رقم الجوال: ' + ph;

  var btn = document.getElementById('calc-cta-btn');
  btn.onclick = function() {
    window.open('https://wa.me/966555589155?text=' + encodeURIComponent(msg), '_blank');
    showToast('جارٍ فتح واتساب بتفاصيل طلبك ✦', 'green');
  };
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') showOverview();
});
</script>
</body>
</html>
